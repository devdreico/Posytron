# Frontend (Vite). Sin estas variables la app corre en modo local (localStorage).
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>

# Supabase Edge Functions (secrets, NUNCA en el repo)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<anon_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# IA
GOOGLE_AI_API_KEY=<gemini_api_key>

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=<access_token>
MERCADOPAGO_WEBHOOK_SECRET=<webhook_secret>

# Vercel (solo para desplegar desde CLI)
VERCEL_TOKEN=<vercel_personal_access_token>
VERCEL_ORG_ID=<org_id>
VERCEL_PROJECT_ID=<project_id>
